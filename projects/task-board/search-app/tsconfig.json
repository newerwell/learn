{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "outDir": "./dist",
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
